<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the device - neither cloud backup nor device-to-device transfer (allowBackup=false
     alone does not stop the latter on some devices). The only way out is a backup JSON the user shares explicitly. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
